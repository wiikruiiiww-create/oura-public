# Buzz production Docker Compose environment.
# Copy to .env and replace every CHANGE_ME value before running.
# Then: chmod 600 .env
#
# Password charset: avoid @ / : # ? in POSTGRES_PASSWORD and REDIS_PASSWORD —
# they are spliced into DATABASE_URL/REDIS_URL without percent-encoding.

# Relay image pinned by immutable digest (built from upstream rev c0d7b52a,
# same epoch as this fork's base — keeps client/server protocol in sync).
# Bump the pin together with an upstream sync of the fork, never separately.
BUZZ_IMAGE=ghcr.io/block/buzz@sha256:7470ac6aa6c1786a60b673e4ecf93fca833bb22b008a7f2c471cc491f1d55e32

# Public host name. Used by compose.caddy.yml and URL-derived settings below.
BUZZ_DOMAIN=buzz.example.com
RELAY_URL=wss://buzz.example.com
BUZZ_MEDIA_BASE_URL=https://buzz.example.com/media
BUZZ_CORS_ORIGINS=https://buzz.example.com

# Production defaults. Closed relay mode requires RELAY_OWNER_PUBKEY and a stable relay key.
BUZZ_REQUIRE_AUTH_TOKEN=true
# Membership gate stays OFF until the bridge registers lead keys via NIP-43
# (kind:9030); enabling it earlier breaks lead onboarding from Telegram.
# Interim: keep the relay behind a firewall (80/443 only) — per-pubkey rate
# limiting is built into the relay and active by default.
BUZZ_REQUIRE_RELAY_MEMBERSHIP=false
# Media GETs require auth (default false = media readable by URL).
BUZZ_REQUIRE_MEDIA_GET_AUTH=true
# Empty value disables push delivery entirely. Unset would silently default
# to Block's gateway (push.buzz.xyz); pushes are iOS-only and unused here.
BUZZ_PUSH_GATEWAY_DELIVERY_URL=
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true
BUZZ_GIT_CONFORMANCE_PROBE=true
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info

# Owner identity. Set to a 64-character hex Nostr pubkey.
RELAY_OWNER_PUBKEY=CHANGE_ME_OWNER_PUBKEY_HEX

# Stable secrets. Generate once, keep in .env, and back up securely.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX_PRIVATE_KEY
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_RANDOM_64_HEX
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
REDIS_PASSWORD=CHANGE_ME_RANDOM_PASSWORD
BUZZ_S3_ACCESS_KEY=CHANGE_ME_RANDOM_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_RANDOM_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media

# Optional host ports. Base compose publishes the relay directly on BUZZ_HTTP_PORT.
BUZZ_HTTP_PORT=3000

# Caddy (compose.caddy.yml only). ACME account email is required for TLS.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_ACME_EMAIL=CHANGE_ME_EMAIL

# Per-service resource limits (compose defaults sized for a 4 GB VPS).
# Override here only if the host is bigger/smaller.
#BUZZ_RELAY_MEM_LIMIT=1g
#POSTGRES_MEM_LIMIT=1g
#REDIS_MEM_LIMIT=256m
#MINIO_MEM_LIMIT=512m

# Dev override ports. Only used with compose.dev.yml.
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
ADMINER_PORT=8082
PROMETHEUS_PORT=9090
